generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dashboard {
  id        Int      @id @default(autoincrement())
  name      String
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id          String   @id
  name        String
  description String?
  category    String
  thumbnail   String?
  widgets     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
