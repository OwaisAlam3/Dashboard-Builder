// prisma/schema.prisma - UPDATED with embed support
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dashboard {
  id          String        @id @default(cuid())
  name        String
  widgets     Json
  isPublic    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  embedTokens EmbedToken[]

  @@index([updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([isPublic])
}

model EmbedToken {
  id          String    @id @default(cuid())
  token       String    @unique
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  permissions String    @default("{}")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([token])
  @@index([dashboardId])
  @@index([expiresAt])
}

model Template {
  id          String   @id
  name        String
  description String?
  category    String
  thumbnail   String?
  icon        String?
  widgets     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
